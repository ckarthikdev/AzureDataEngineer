												"userProperties": [],
												"typeProperties": {
													"variableName": "NextSkip",
													"value": {
														"value": "@add(\nvariables('Skip'),\npipeline().parameters.Limit\n)",
														"type": "Expression"
													}
												}
											},
											{
												"name": "Update Skip",
												"type": "SetVariable",
												"dependsOn": [
													{
														"activity": "Calculate Next Skip",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "Skip",
													"value": {
														"value": "@variables('NextSkip')",
														"type": "Expression"
													}
												}
											}
										],
										"ifTrueActivities": [
											{
												"name": "Update the HasMoreData",
												"type": "SetVariable",
												"dependsOn": [],
												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "HasMoreData",
													"value": false
												}
											}
										]
									}
								},
								{
									"name": "Set RecordCount",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "TotalRecords",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "RecordCount",
										"value": {
											"value": "@length(activity('Get Total Records').output.users)",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.12:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"BaseURL": {
						"type": "string",
						"defaultValue": "https://dummyjson.com"
					},
					"Endpoint": {
						"type": "string",
						"defaultValue": "users"
					},
					"Limit": {
						"type": "int",
						"defaultValue": 100
					}
				},
				"variables": {
					"Skip": {
						"type": "Integer",
						"defaultValue": 0
					},
					"TotalRecords": {
						"type": "Integer"
					},
					"HasMoreData": {
						"type": "Boolean",
						"defaultValue": true
					},
					"FileName": {
						"type": "String",
						"defaultValue": "\"\""
					},
					"NextSkip": {
						"type": "Integer",
						"defaultValue": 0
					},
					"RecordCount": {
						"type": "Integer",
						"defaultValue": 0
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-30T15:46:15Z"
			},
			"dependsOn": []
		},
