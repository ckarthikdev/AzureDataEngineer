		{
			"name": "[concat(parameters('factoryName'), '/PL_MetaDataDriven_IncrementalLoad')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKP_ControlTable",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT SourceSchema, SourceTable, WatermarkColumn, SinkContainer, SinkFolder, SinkFileName, LoadType\nFROM retail.ControlTable\nWHERE IsActive = 1",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AzureSql_Retail",
								"type": "DatasetReference",
								"parameters": {
									"SchemaName": "retail",
									"TableName": "ControleTable"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FEACH_PerTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LKP_ControlTable",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LKP_ControlTable').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 5,
							"activities": [
								{
									"name": "COPY_SqlToAdls",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "LKP_OldWatermark",
											"dependencyConditions": [
												"Succeeded"
											]
										},
										{
											"activity": "LKP_NewWatermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@if(equals(item().LoadType, 'Full'),\r\n   concat('SELECT * FROM ', item().SourceSchema, '.', item().SourceTable),\r\n   concat('SELECT * FROM ', item().SourceSchema, '.', item().SourceTable,\r\n          ' WHERE ', item().WatermarkColumn, ' > ''',\r\n          activity('LKP_OldWatermark').output.firstRow.WatermarkValue,\r\n          ''' AND ', item().WatermarkColumn, ' <= ''',\r\n          activity('LKP_NewWatermark').output.firstRow.NewWatermark, '''')\r\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "FlattenHierarchy"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_AzureSql_Retail",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": {
													"value": "@item().SourceSchema",
													"type": "Expression"
												},
												"TableName": "@item().SourceTable"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_AdlsGen2_Parquet_Retail",
											"type": "DatasetReference",
											"parameters": {
												"ContainerName": "@item().SinkContainer",
												"FolderName": "@item().SinkFolder",
												"FileName": "@item().SinkFileName"
											}
										}
									]
								},
								{
									"name": "LKP_OldWatermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat('SELECT WatermarkValue FROM retail.WatermarkTable WHERE SourceSchema = ''', item().SourceSchema, ''' AND SourceTable = ''', item().SourceTable, '''')",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_AzureSql_Retail",
											"type": "DatasetReference",
											"parameters": {
												"SchemaName": "retail",
												"TableName": "WatermarkTable"
											}
										}
									}
								},
								{
									"name": "LKP_NewWatermark",
									"type": "Lookup",
									"dependsOn": [],
