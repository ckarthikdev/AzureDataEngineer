									"typeProperties": {
										"method": "GET",
										"headers": {},
										"url": {
											"value": "@concat(\r\npipeline().parameters.BaseURL,\r\n'/',\r\npipeline().parameters.Endpoint,\r\n'?limit=',\r\nstring(pipeline().parameters.Limit),\r\n'&skip=',\r\nstring(variables('Skip'))\r\n)",
											"type": "Expression"
										}
									}
								},
								{
									"name": "TotalRecords",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Get Total Records",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "TotalRecords",
										"value": {
											"value": "@activity('Get Total Records').output.total",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Copy data1",
									"type": "Copy",
