{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfclick4cast"
		},
		"ls_Adls_Gen2_token_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_Adls_Gen2_token'"
		},
		"ls_api_adls_gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_api_adls_gen2'"
		},
		"ls_Adls_Gen2_token_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retaildatastorage01.dfs.core.windows.net/"
		},
		"ls_api_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retaildatastorage01.dfs.core.windows.net/"
		},
		"ls_api_url_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com"
		},
		"ls_rest_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://www.quickpickdeal.com/api/Customer/GetAllCustomers"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfclick4cast_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_Adls_Gen2_token_accountKey": {
						"value": "[parameters('ls_Adls_Gen2_token_accountKey')]"
					},
					"ls_api_adls_gen2_accountKey": {
						"value": "[parameters('ls_api_adls_gen2_accountKey')]"
					},
					"ls_Adls_Gen2_token_properties_typeProperties_url": {
						"value": "[parameters('ls_Adls_Gen2_token_properties_typeProperties_url')]"
					},
					"ls_api_adls_gen2_properties_typeProperties_url": {
						"value": "[parameters('ls_api_adls_gen2_properties_typeProperties_url')]"
					},
					"ls_api_url_properties_typeProperties_url": {
						"value": "[parameters('ls_api_url_properties_typeProperties_url')]"
					},
					"ls_rest_api_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_api_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}